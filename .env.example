# ---------------------------------------------------------------------------
# Grindstone environment. Every variable the app reads is listed here.
# Nothing in the codebase is specific to Neon or to Vercel: any Postgres works.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local development: use the container from compose.yaml (see .env.local).
# Production: a Neon pooled connection string works unchanged.
DATABASE_URL=postgres://grindstone:grindstone@localhost:5432/grindstone

# Session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public base URL of this instance. http://localhost:3000 in development.
BETTER_AUTH_URL=http://localhost:3000

# Public base URL used by the browser auth client. Leave unset to use a
# relative path, which is correct whenever the app is served from one origin.
NEXT_PUBLIC_BETTER_AUTH_URL=

# Optional. The browser-side auth client reads this one, because only
# NEXT_PUBLIC_ variables are inlined into the client bundle. Leave it unset and
# the client calls /api/auth on whatever origin served the page, which is what
# makes one build work on localhost, a preview host and production alike. Set
# it only when the auth routes live on a different origin than the app.
# NEXT_PUBLIC_BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# OAuth. Both providers are optional: the sign-in page only shows the buttons
# whose credentials are present, so the app runs fine with neither configured.
# GitHub:  https://github.com/settings/developers
#          callback -> {BETTER_AUTH_URL}/api/auth/callback/github
# Google:  https://console.cloud.google.com/apis/credentials
#          callback -> {BETTER_AUTH_URL}/api/auth/callback/google
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
